# Build-time (public) values for Astro. Copy to .env for local dev.
SITE_URL=https://example.com
# Browser key: restrict to your domain (HTTP referrers) and to Maps JavaScript API + Places API (New).
PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Cloudflare Turnstile site key (leave blank in local dev to skip the widget).
PUBLIC_TURNSTILE_SITE_KEY=
